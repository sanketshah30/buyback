{
  "name": "buyback-platform",
  "private": true,
  "version": "1.0.0",
  "description": "Agentic buyback assessment platform monorepo (frontend PWA + server API)",
  "workspaces": [
    "frontend",
    "server"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace server",
    "dev:frontend": "npm run dev --workspace frontend",
