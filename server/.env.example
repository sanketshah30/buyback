PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

MOCK_OTP_CODE=123456
MOCK_OTP_EXPOSE_IN_RESPONSE=true
LOGIN_OTP_TTL_MINUTES=5
CONFIRMATION_OTP_TTL_MINUTES=2

DIAGNOSIS_COMPLETE_AFTER_POLLS=3

NO_DIAGNOSIS_FIXED_DEDUCTION=6000

# in-memory | postgres | supabase
DATA_DRIVER=in-memory

# Supabase / Vercel Postgres (pooled). Required when DATA_DRIVER=postgres|supabase.
POSTGRES_URL=
# Direct connection for migrate/seed (avoids transaction pooler DDL limits).
POSTGRES_URL_NON_POOLING=
# Optional alias accepted by the server if POSTGRES_URL is unset.
DATABASE_URL=

# Legacy MySQL-shaped placeholders (unused by the postgres driver).
DB_HOST=localhost
DB_PORT=3306
DB_NAME=buyback
DB_USER=buyback_app
DB_PASSWORD=changeme
