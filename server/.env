# Buyback server environment configuration
# NOTE: This is an MVP with a mock, in-memory data layer - no real secrets live here.
# When wiring up the real MySQL database, move any production secrets to a
# non-committed .env.local / secret manager instead of this tracked file.

PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Auth
JWT_SECRET=buyback-dev-mock-secret-change-me
JWT_EXPIRES_IN=7d

# Mock OTP (used for both login and buyback confirmation flows in the MVP)
MOCK_OTP_CODE=123456
MOCK_OTP_EXPOSE_IN_RESPONSE=true

# Diagnosis polling simulation
DIAGNOSIS_COMPLETE_AFTER_POLLS=3

# Valuation
NO_DIAGNOSIS_VALUE_DROP_PERCENT=35

# Data layer - toggle when a real database is wired up (see src/repositories)
DATA_DRIVER=in-memory

# --- Future MySQL connection (unused by the in-memory driver, kept for parity) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=buyback
DB_USER=buyback_app
DB_PASSWORD=changeme
