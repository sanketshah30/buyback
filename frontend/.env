# Leave empty (relative) to go through the Vite dev server proxy configured
# in vite.config.ts, which forwards /api and /uploads to the backend. This
# works both on plain localhost and when the app is viewed through a
# forwarded/tunneled preview URL. Only set this to an absolute URL
# (e.g. http://localhost:4000) if you're running the frontend separately
# from the proxy (e.g. a static build served elsewhere) and pointing it at
# a specific backend host.
VITE_API_BASE_URL=
